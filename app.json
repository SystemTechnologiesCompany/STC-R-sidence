{
  "expo": {
    "name": "STC Résidence",
    "slug": "stc-residence",
    "scheme": "stc-residence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/stc-logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/stc-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/stc-logo.png"
    }
  }
}
